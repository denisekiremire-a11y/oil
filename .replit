run = "npm install --include=dev && npm start"
entrypoint = "server/src/index.js"
modules = ["nodejs-22"]

[env]
NODE_ENV = "production"

[[ports]]
localPort = 3001
externalPort = 80

[deployment]
build = ["sh", "-c", "npm install --include=dev && npm run build -w client"]
run = ["sh", "-c", "npm run start -w server"]
